+    def _session_id_from_episode(self, episode):
+        return session_id_of(episode.episode_id, getattr(episode, "info", None))
+
+    def _memory_stage_dir(self, session_id):
+        root = str(getattr(self.config.EVAL, "MEMORY_ROOT", "") or "")
+        stage = str(getattr(self.config.EVAL, "MEMORY_STAGE", "M0") or "M0")
+        return os.path.join(root, "sessions", str(session_id), "stages", stage)
+
+    def _memory_load_dir(self, session_id):
+        root = str(getattr(self.config.EVAL, "LOAD_MEMORY_ROOT", "") or "")
+        if not root:
+            root = str(getattr(self.config.EVAL, "MEMORY_ROOT", "") or "")
+        stage = str(getattr(self.config.EVAL, "LOAD_MEMORY_STAGE", "M0") or "M0")
+        return os.path.join(root, "sessions", str(session_id), "stages", stage)
+
+    def _instruction_text(self, episode):
+        instr = getattr(episode, "instruction", None)
+        if instr is None:
+            return ""
+        text = getattr(instr, "instruction_text", None)
+        if text:
+            return str(text)
+        if isinstance(instr, dict):
+            return str(instr.get("instruction_text") or "")
+        return str(instr)
+
+    def _dump_episode_native(self, env_index, episode, metric):
+        memory_root = str(getattr(self.config.EVAL, "MEMORY_ROOT", "") or "")
+        if not memory_root:
+            return
+        session_id = self._session_id_from_episode(episode)
+        dest = self._memory_stage_dir(session_id)
+        os.makedirs(dest, exist_ok=True)
+        graph_fn = os.path.join(dest, "graphmap.pt")
+        rollout_fn = os.path.join(dest, "rollout.json")
+        metrics_fn = os.path.join(dest, "metrics.json")
+        tmp_graph = graph_fn + ".tmp"
+        torch.save(self.gmaps[env_index].export_state(), tmp_graph)
+        os.replace(tmp_graph, graph_fn)
+        poses = self.envs.call_at(env_index, "get_pose_trace", {})
+        info = getattr(episode, "info", None) or {}
+        if info.get("level1_session_id") or str(episode.episode_id).startswith("level1_"):
+            level = "level1"
+        elif info.get("level3_session_id") or info.get("level3_task_id") or str(episode.episode_id).startswith("level3_"):
+            level = "level3"
+        else:
+            level = "level2"
+        role = str(
+            info.get("level1_role")
+            or info.get("level3_role")
+            or info.get("level2_role")
+            or self.config.EVAL.SPLIT
+        )
+        start_position = [float(x) for x in np.asarray(episode.start_position).tolist()]
+        start_rotation = [float(x) for x in np.asarray(episode.start_rotation).tolist()]
+        pose7 = []
+        for pose in poses:
+            position = [float(x) for x in pose["position"]]
+            rotation = [float(x) for x in pose["rotation_xyzw"]]
+            pose7.append(position + rotation)
+        payload = {
+            "schema_version": f"etpnav_{level}_native_rollout_v1",
+            "phase": f"{level}_{self.config.EVAL.SPLIT}",
+            "episode_id": str(episode.episode_id),
+            "scene_id": str(episode.scene_id),
+            "session_id": session_id,
+            "role": role,
+            "instruction": self._instruction_text(episode),
+            "start_position": start_position,
+            "start_rotation_xyzw": start_rotation,
+            "start_pose7": start_position + start_rotation,
+            "poses": poses,
+            "positions": [pose["position"] for pose in poses],
+            "rotations_xyzw": [pose["rotation_xyzw"] for pose in poses],
+            "pose7": pose7,
+            "graphmap_path": graph_fn,
+            "metrics": metric,
+        }
+        tmp_rollout = rollout_fn + ".tmp"
+        with open(tmp_rollout, "w") as handle:
+            json.dump(payload, handle, indent=2)
+        os.replace(tmp_rollout, rollout_fn)
+        tmp_metrics = metrics_fn + ".tmp"
+        with open(tmp_metrics, "w") as handle:
+            json.dump(metric, handle, indent=2)
+        os.replace(tmp_metrics, metrics_fn)
