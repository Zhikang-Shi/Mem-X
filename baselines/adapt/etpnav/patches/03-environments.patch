+    def _current_pose(self):
+        agent_state = self._env.sim.get_agent_state()
+        rotation = agent_state.rotation
+        return {
+            "frame_index": len(self.pose_trace),
+            "simulator_step": int(self.simulator_step),
+            "position": [float(x) for x in np.asarray(agent_state.position).tolist()],
+            "rotation_xyzw": [
+                float(rotation.imag[0]),
+                float(rotation.imag[1]),
+                float(rotation.imag[2]),
+                float(rotation.real),
+            ],
+        }
+
+    def _record_pose(self, bump_step=False):
+        if bump_step:
+            self.simulator_step += 1
+        pose = self._current_pose()
+        if self.pose_trace:
+            prev = self.pose_trace[-1]
+            if prev["position"] == pose["position"] and prev["rotation_xyzw"] == pose["rotation_xyzw"]:
+                return
+        pose["frame_index"] = len(self.pose_trace)
+        self.pose_trace.append(pose)
+
+    def get_pose_trace(self):
+        return list(self.pose_trace)
+
