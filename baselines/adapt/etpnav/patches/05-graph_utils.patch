+    @staticmethod
+    def _to_numpy(value):
+        if torch.is_tensor(value):
+            return value.detach().cpu().numpy()
+        return np.asarray(value)
+
+    def graph_hop(self, src, dst, default=MAX_DIST):
+        hop = self.shortest_dist.get(src, {}).get(dst)
+        return default if hop is None else hop
+
+    def export_state(self):
+        ghost_embeds = {}
+        for vp, (feat, count) in self.ghost_embeds.items():
+            ghost_embeds[vp] = [self._to_numpy(feat), int(count)]
+        return {
+            "schema": "etpnav_graphmap_v1",
+            "has_real_pos": bool(self.has_real_pos),
+            "loc_noise": float(self.loc_noise),
+            "merge_ghost": bool(self.merge_ghost),
+            "ghost_aug": float(self.ghost_aug),
+            "ghost_cnt": int(self.ghost_cnt),
+            "node_pos": {vp: np.asarray(pos) for vp, pos in self.node_pos.items()},
+            "node_embeds": {vp: self._to_numpy(ft) for vp, ft in self.node_embeds.items()},
+            "node_stepId": dict(self.node_stepId),
+            "node_stop_scores": dict(self.node_stop_scores),
+            "graph_edges": [
+                (u, v, float(data.get("weight", 0.0)))
+                for u, v, data in self.graph_nx.edges(data=True)
+            ],
+            "ghost_pos": {vp: [np.asarray(p) for p in pos] for vp, pos in self.ghost_pos.items()},
+            "ghost_mean_pos": {vp: np.asarray(pos) for vp, pos in self.ghost_mean_pos.items()},
+            "ghost_embeds": ghost_embeds,
+            "ghost_fronts": {vp: list(fronts) for vp, fronts in self.ghost_fronts.items()},
+            "ghost_real_pos": {
+                vp: [np.asarray(p) for p in pos] for vp, pos in self.ghost_real_pos.items()
+            },
+        }
+
+    def load_state(self, state, device=None):
+        if not state:
+            return
+        if device is None:
+            device = torch.device("cpu")
+
+        def as_tensor(value):
+            tensor = torch.as_tensor(np.asarray(value), dtype=torch.float32)
+            return tensor.to(device)
+
+        self.has_real_pos = bool(state.get("has_real_pos", self.has_real_pos))
+        self.loc_noise = float(state.get("loc_noise", self.loc_noise))
+        self.merge_ghost = bool(state.get("merge_ghost", self.merge_ghost))
+        self.ghost_aug = float(state.get("ghost_aug", self.ghost_aug))
+        self.ghost_cnt = int(state.get("ghost_cnt", 0))
+        self.node_pos = {vp: np.asarray(pos) for vp, pos in state.get("node_pos", {}).items()}
+        self.node_embeds = {vp: as_tensor(ft) for vp, ft in state.get("node_embeds", {}).items()}
+        self.node_stepId = dict(state.get("node_stepId", {}))
+        self.node_stop_scores = dict(state.get("node_stop_scores", {}))
+        self.graph_nx = nx.Graph()
+        self.graph_nx.add_nodes_from(self.node_pos.keys())
+        for edge in state.get("graph_edges", []):
+            u, v, weight = edge[0], edge[1], float(edge[2]) if len(edge) > 2 else 0.0
+            self.graph_nx.add_edge(u, v, weight=weight)
+        self.ghost_pos = {
+            vp: [np.asarray(p) for p in pos] for vp, pos in state.get("ghost_pos", {}).items()
+        }
+        self.ghost_mean_pos = {
+            vp: np.asarray(pos) for vp, pos in state.get("ghost_mean_pos", {}).items()
+        }
+        self.ghost_embeds = {}
+        for vp, payload in state.get("ghost_embeds", {}).items():
+            feat, count = payload[0], int(payload[1])
+            self.ghost_embeds[vp] = [as_tensor(feat), count]
+        self.ghost_fronts = {vp: list(fronts) for vp, fronts in state.get("ghost_fronts", {}).items()}
+        self.ghost_real_pos = {
+            vp: [np.asarray(p) for p in pos] for vp, pos in state.get("ghost_real_pos", {}).items()
+        }
+        self.ghost_aug_pos = deepcopy(self.ghost_mean_pos)
+        if self.node_pos:
+            self.shortest_path = dict(nx.all_pairs_dijkstra_path(self.graph_nx))
+            self.shortest_dist = dict(nx.all_pairs_dijkstra_path_length(self.graph_nx))
+        else:
+            self.shortest_path = {}
+            self.shortest_dist = {}
